/*!
 * \file all_to_all_matmul_ccu.asc
 * \brief AllToAll MX Quant Matmul（CCU 版）——单翻译单元锚点 + 高级接口（host 编排 + AIC kernel 入口 + 双流 launch）
 *
 * 本文件是唯一编译锚点：消费方 TU（src/main.cpp）只 include 本文件。
 * ⚠️ ccu_all_to_all.asc 的 __ccu_host__ kernel 每个二进制只能引入一次，本锚点是唯一引入处。
 *
 * 双流架构（AllToAllMatmulCustom 一次调用下发两个 kernel）：
 *   streamCcu    CcuAllToAllMesh1DKernel：wake 后单类发布，循环 dataCommTurn 轮（轮 0 =
 *                data 块 0 + scale 整块搭载），每轮末 PostSync 落地确认 + EventRecord 通知 AIC
 *   streamAicore AllToAllQuantMatmulKernelCcu：block 0 清事件残值 → commit；全核融合
 *                matmul 逐 tile 轮询 round-done，tile 级通算 overlap
 */

#pragma once

#include "ccu_all_to_all.asc"              // 通信域：CCU 通信服务（__ccu_host__ kernel，名字冻结）
#include "ccu_all_to_all_tiling_data.h" // tiling：聚合结构体 + FillAllToAllMatmulTilingData（SWAT）
#include "all_to_all_matmul_aic.h"         // 计算域：AIC 同步原语 + WaitPolicy + 融合 matmul 编排

// ══════════ §1 host 编排 ══════════

// 编排流程：Validate（check，不触碰 CCU 资源）→ PrepareCcuCommResources（分配 CCU 资源并
// 填 tiling 资源字段）→ RefreshCcuCommStage（每次调用刷通信参数入 kernelArg->stage）→
// AllToAllMatmulCustom（§2，双流 launch）→ ReleaseAllToAllMatmulContext（循环外统一一次）。
// tiling 分工：main 填 comm.tileM + matmul 全部字段，Validate/Prepare 填 comm 其余字段。

// 编排结果：填充后交给 .asc 中的 AllToAllMatmulCustom
struct AllToAllMatmulContext {
    asccomm_ccu_schd schd;
    void* insHandle{nullptr};
    // 单组 kernelArg（管理 dataCommTurn+1 个 Event；通信参数随 kernelArg->stage 按值直达 CCU）
    std::shared_ptr<CcuKernelArgAllToAllMesh1D> kernelArg;
    // 统一 tiling：matmul 由 Custom 入参拷入；comm 由 Validate（形状）+ Prepare（资源）填充
    ccuAllToAllMatmulTilingData tiling{};
    // workspace 布局用全量尺寸（data 区 = inputSize，scale 区紧随）
    uint64_t inputSize{0};      // x1 全量字节 = M*K
    uint64_t scaleInputSize{0}; // x1Scale 全量字节 = M*scaleKLen
    // CCU DIE 信息（dieId 供资源分配，dieMask 供 schd）
    uint32_t dieId{0};
    uint64_t dieMask{0};
};

// 前置检查（不触碰 CCU 资源）：指针/参数校验 + rank 查询 + 全部切分尺寸计算（填 comm
// 形状/轮次字段）。sendCount==0 返回 SUCCESS 且 skip=true
inline HcclResult ValidateAllToAllMatmulParams(void* x1, void* workspace, void* x1Scale, HcclComm comm,
                                               uint64_t sendCount, uint64_t scaleCount, uint64_t workspaceSize,
                                               HcclDataType dataType, AllToAllMatmulContext& ctx, bool& skip)
{
    CHK_PTR_NULL(comm);
    CHK_PTR_NULL(x1);
    CHK_PTR_NULL(workspace);
    CHK_PTR_NULL(x1Scale);
    if (sendCount == 0) {
        skip = true;
        return HCCL_SUCCESS;
    }

    HCCLCHECK(HcclGetRankId(comm, &ctx.tiling.comm.rankId));
    HCCLCHECK(HcclGetRankSize(comm, &ctx.tiling.comm.rankSize));

    // rankSize == 0 除零风险；> CCU_MAX_RANK_SIZE(16) 越界 device 侧 channels 数组
    const uint32_t rankSize = ctx.tiling.comm.rankSize;
    if (rankSize == 0 || rankSize > CCU_MAX_RANK_SIZE) {
        return HCCL_E_PARA;
    }

    // dtype 固定 FP8 E4M3FN（1 字节，按 HCCL_DATA_TYPE_INT8 通道传）
    if (dataType != HCCL_DATA_TYPE_INT8) {
        return HCCL_E_PARA;
    }
    const uint64_t perDataSize = SIZE_TABLE[dataType];

    // MXFP8：K 须为 64 倍数（scale 组对齐），scaleKLen = K/64*2
    constexpr uint64_t MXFP_DIVISOR = 64;
    constexpr uint64_t MXFP_MULTI = 2;
    const QuantMatmulTilingData& mmTile = ctx.tiling.matmul;
    const uint64_t K = mmTile.k;
    if (K == 0 || K % MXFP_DIVISOR != 0) {
        return HCCL_E_PARA;
    }
    const uint64_t scaleKLen = K / MXFP_DIVISOR * MXFP_MULTI;

    if (sendCount % K != 0) {
        return HCCL_E_PARA;
    }
    const uint64_t M = sendCount / K;
    if (M % rankSize != 0) {
        return HCCL_E_PARA; // token 轴均分 R 块，须整除
    }
    const uint64_t blockRows = M / rankSize;

    // matmul.m 必须与通信切分一致（kernel 的 originalM/problemShape.M 均取自它）
    if (mmTile.m != blockRows) {
        return HCCL_E_PARA;
    }
    if (mmTile.n == 0 || mmTile.baseM == 0 || mmTile.baseN == 0 || mmTile.baseK == 0 ||
        mmTile.baseK % MXFP_DIVISOR != 0 || mmTile.usedCoreNum == 0) {
        return HCCL_E_PARA;
    }

    // dataCommTurn = blockRows/tileM（tileM 即 WaitTile 的通信轮映射粒度）
    const uint64_t tileM = ctx.tiling.comm.tileM;
    if (tileM == 0 || blockRows % tileM != 0) {
        return HCCL_E_PARA;
    }
    if (blockRows / tileM > MAX_COMMTURN) {
        return HCCL_E_PARA;
    }
    ctx.tiling.comm.dataCommTurn = static_cast<uint32_t>(blockRows / tileM);

    ctx.inputSize = sendCount * perDataSize;
    if (ctx.inputSize % rankSize != 0) {
        return HCCL_E_PARA;
    }
    ctx.tiling.comm.params.blockSize = ctx.inputSize / rankSize;
    ctx.tiling.comm.params.srcStride = ctx.tiling.comm.params.blockSize;
    ctx.tiling.comm.params.subBytes = ctx.tiling.comm.params.blockSize / ctx.tiling.comm.dataCommTurn;
    if (ctx.tiling.comm.params.subBytes % perDataSize != 0) {
        return HCCL_E_PARA;
    }

    // scale 整块（每对端一个 Write，不拆分）随 data 轮 0 搭载
    ctx.scaleInputSize = static_cast<uint64_t>(M) * scaleKLen;
    if (scaleCount != ctx.scaleInputSize) {
        return HCCL_E_PARA;
    }
    if (ctx.scaleInputSize % rankSize != 0) {
        return HCCL_E_PARA;
    }
    ctx.tiling.comm.params.scaleSliceSize = ctx.scaleInputSize / rankSize;
    ctx.tiling.comm.params.scaleSrcStride = ctx.tiling.comm.params.scaleSliceSize;
    // scale 目的偏移（相对对端发布的 recvBuf 地址）：region 偏移（recvScale 紧邻 recvData，
    // = workspaceScaleOffset = inputSize）+ rankId 块内偏移，host 烘焙——CCU 侧从发布值闭式派生
    ctx.tiling.comm.params.scaleDstOffset =
        ctx.inputSize + static_cast<uint64_t>(ctx.tiling.comm.rankId) * ctx.tiling.comm.params.scaleSliceSize;

    // workspace [recvData | recvScale]
    ctx.tiling.comm.workspaceScaleOffset = ctx.inputSize;
    if (workspaceSize < ctx.inputSize + ctx.scaleInputSize) {
        return HCCL_E_PARA;
    }

    return HCCL_SUCCESS;
}

// 获取 CCU channels（每远端 rank 一条点到点通道）+ 查询通信域 CCU 实例。
// 实例归通信域持有（HcclCommQueryCcuIns 查询实体指针）：Release 侧无需销毁
inline HcclResult AcquireCommChannelsAndInstance(HcclComm comm, uint32_t rankId, uint32_t rankSize,
                                                 std::vector<ChannelHandle>& kernelChannels, AllToAllMatmulContext& ctx)
{
    uint32_t dieId = 0;
    HCCLCHECK(AcquireCcuChannels(comm, rankId, rankSize, kernelChannels, dieId));
    if (dieId >= CCU_DIE_NUM) {
        return HCCL_E_PARA;
    }
    ctx.dieId = dieId;
    ctx.dieMask = 1ULL << dieId;

    // 实例由通信域持有（实体指针经 HcclCommQueryCcuIns 查询）；事件/token 等资源
    // 经 asccomm_ccu_* 从通信域实例分配，Release 无需销毁实例
    void* insHandle = nullptr;
    HCCLCHECK(QueryCcuInstance(comm, insHandle));
    ctx.insHandle = insHandle;
    return HCCL_SUCCESS;
}

// 计算通信 tiling 的 goSize（本地拷贝 loop 参数，data/scale 各一）。
// data 轮的 src/dst/slice 偏移由 CCU 侧 LoadRoundArgs 从 stage 标量闭式派生，不建表
inline HcclResult ComputeCommTiling(AllToAllMatmulContext& ctx)
{
    ctx.tiling.comm.params.goSize = CalGoSize(ctx.tiling.comm.params.subBytes, MakeLocalCopyConfig());
    ctx.tiling.comm.params.scaleGoSize = CalGoSize(ctx.tiling.comm.params.scaleSliceSize, MakeLocalCopyConfig());
    return HCCL_SUCCESS;
}

// 每次调用刷新通信地址入 kernelArg->stage（随 CCU kernel launch 按值直达）。
// 先同步 streamCcu，确保上一帧 CCU kernel 已退出（串行契约）
inline HcclResult RefreshCcuCommStage(void* x1, void* x1Scale, void* workspace, AllToAllMatmulContext& ctx,
                                      aclrtStream streamCcu)
{
    if (aclrtSynchronizeStream(streamCcu) != ACL_SUCCESS) {
        return HCCL_E_INTERNAL;
    }
    CcuCommStageParams& params = ctx.tiling.comm.params;
    params.x1Addr = reinterpret_cast<uint64_t>(x1);
    params.x1ScaleAddr = reinterpret_cast<uint64_t>(x1Scale);
    params.recvBufAddr = reinterpret_cast<uint64_t>(workspace);
    ctx.kernelArg->stage = params;
    return HCCL_SUCCESS;
}

// CCU 通信资源准备（prepare 阶段，不做 kernel launch）。前置：Validate 已通过。
// 复用守卫：insHandle 已就绪且资源规模与当前 shape 核对一致 → 直接返回（shape 变化须先
// Release 再重建；buffer 地址须保持稳定）
inline HcclResult PrepareCcuCommResources(void* x1, void* x1Scale, HcclComm comm, AllToAllMatmulContext& ctx)
{
    if (ctx.insHandle != nullptr) {
        const uint32_t turn = ctx.tiling.comm.dataCommTurn;
        if (ctx.kernelArg->commTurn != turn || ctx.kernelArg->eventNum != turn + 1) {
            return HCCL_E_PARA;
        }
        return HCCL_SUCCESS;
    }

    std::vector<ChannelHandle> kernelChannels;
    HCCLCHECK(
        AcquireCommChannelsAndInstance(comm, ctx.tiling.comm.rankId, ctx.tiling.comm.rankSize, kernelChannels, ctx));

    HCCLCHECK(AllocAllToAllRegion(ctx.insHandle, ctx.dieId, ctx.tiling.comm, kernelChannels, ctx.kernelArg));

    // token 按内存区域（VA+size）签发：x1 与 x1Scale 独立分配，须各取各的
    // （data 块 / scale 块读源各用各的令牌）
    HCCLCHECK(ConvertCcuToHccl(
        asccomm_ccu_get_mem_token(reinterpret_cast<uint64_t>(x1), ctx.inputSize, &ctx.tiling.comm.params.token)));
    HCCLCHECK(ConvertCcuToHccl(asccomm_ccu_get_mem_token(reinterpret_cast<uint64_t>(x1Scale), ctx.scaleInputSize,
                                                         &ctx.tiling.comm.params.scaleToken)));

    HCCLCHECK(ComputeCommTiling(ctx));

    // binaryCacheTag 按 rank 区分（进程级缓存不按设备隔离，同 tag 会让 rank1-3 命中
    // rank0 的 handle）：重复 launch（perf 多迭代）依赖缓存复用，tag=0 每次重注册会在
    // 第二次 launch 挂死（asc-comm 示例仅单次 launch 未覆盖此场景）
    ctx.schd = {1, 0, ctx.dieMask, asccomm_ccu_get_launch_hash_tag("CcuAllToAllMesh1DKernel") + ctx.tiling.comm.rankId};

    return HCCL_SUCCESS;
}

// 释放 CCU 资源，与 Prepare 首帧分配配对。调用时机：迭代循环外统一一次
// （须在双流 sync 之后——实例销毁后 MMIO 地址失效）
inline HcclResult ReleaseAllToAllMatmulContext(AllToAllMatmulContext& ctx)
{
    return ReleaseCcuContext(ctx.tiling.comm, ctx.insHandle);
}

// ══════════ §2 AIC kernel 入口 + 双流 launch ══════════

// 纯 AIC：InitSocState → AllToAllMatmulProcess（block 0 事件清扫 + commit；全核融合 matmul）。
// 显式声明 kernel 类型（不依赖函数体指令形态，通信-only 等裁剪场景同样成立）
__global__ __aicore__ void AllToAllQuantMatmulKernelCcu(__gm__ void* x1, __gm__ void* x1Scale, __gm__ void* x2,
                                                        __gm__ void* x2Scale, __gm__ void* output,
                                                        __gm__ void* workspace, ccuAllToAllMatmulTilingData tilingData)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    AscendC::InitSocState();

    AllToAllMatmulProcess(x1, x1Scale, x2, x2Scale, output, workspace, tilingData);
}

// ---- host 侧：编排 + 双流 launch 入口 ----
// Validate → PrepareCcuCommResources → CCU kernel launch → AIC kernel launch；
// 同 shape 迭代经复用守卫直接返回，仅首帧分配资源
HcclResult AllToAllMatmulCustom(void* x1, void* x1Scale, void* x2, void* x2Scale, void* output, void* workspace,
                                uint64_t sendCount, uint64_t scaleCount, uint64_t workspaceSize, HcclDataType dataType,
                                HcclComm comm, aclrtStream streamAicore, aclrtStream streamCcu,
                                ccuAllToAllMatmulTilingData& tilingData, AllToAllMatmulContext& ctx)
{
    CHK_PTR_NULL(streamAicore);
    CHK_PTR_NULL(streamCcu);
    CHK_PTR_NULL(x2);
    CHK_PTR_NULL(x2Scale);
    CHK_PTR_NULL(output);

    // tiling 入 ctx：首帧整体接收；复用帧仅刷新 caller 可变部分（matmul 切分 + comm.tileM），
    // 整体覆盖会清掉 Validate/Prepare 已填入的形状与资源字段
    if (ctx.insHandle == nullptr) {
        ctx.tiling = tilingData;
    } else {
        ctx.tiling.matmul = tilingData.matmul;
        ctx.tiling.comm.tileM = tilingData.comm.tileM;
    }

    bool skip = false;
    HcclResult ret = ValidateAllToAllMatmulParams(x1, workspace, x1Scale, comm, sendCount, scaleCount, workspaceSize,
                                                  dataType, ctx, skip);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    if (skip) {
        return HCCL_SUCCESS;
    }

    ret = PrepareCcuCommResources(x1, x1Scale, comm, ctx);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    // 通信参数直达：每次调用刷新 kernelArg->stage（内含 streamCcu 同步）
    ret = RefreshCcuCommStage(x1, x1Scale, workspace, ctx, streamCcu);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    // CCU 通信 kernel launch（streamCcu，仅 1 次，kernel 内部循环 dataCommTurn 次）；
    // 下发顺序 CCU 先、AIC 后
    CcuAllToAllMesh1DKernel<<<ctx.schd, ctx.insHandle, streamCcu>>>(ctx.kernelArg.get());

    // AIC 融合 kernel launch（纯 AIC，streamAicore，block 数 = usedCoreNum）
    AllToAllQuantMatmulKernelCcu<<<ctx.tiling.matmul.usedCoreNum, 0, streamAicore>>>(x1, x1Scale, x2, x2Scale, output,
                                                                                     workspace, ctx.tiling);

    return HCCL_SUCCESS;
}
