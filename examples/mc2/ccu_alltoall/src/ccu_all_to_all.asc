/*!
 * \file ccu_all_to_all.asc
 * \brief CCU AllToAll 通信服务——通信参数契约、host 资源装配、__ccu_host__ 通信 kernel
 *
 * 公共件（契约 + LoopGroup 引擎 + host 资源管理）在 ccu_comm.h（本文件头部引入）。
 * ⚠️ 单翻译单元铁律：本文件定义 __ccu_host__ kernel（binaryCacheTag = kernel 名哈希 +
 * rankId，单进程多 rank 线程共存依赖），每个二进制只能引入一次——消费方只 include
 * 锚点 all_to_all_matmul_ccu.asc，由锚点唯一引入本文件，不要单独 include。
 */

#pragma once

#include "ccu_comm.h" // CCU 通信公共件（契约 + LoopGroup 引擎 + host 资源）

// ══════════ §2 通信参数契约 ══════════

// CcuCommTilingData 是通信参数的 host 侧唯一事实源：形状/轮次由 Validate 计算，
// 资源字段由 Prepare 填入；每次调用经 RefreshCcuCommStage 抄入 kernelArg->stage 直达 CCU。
// 事件契约（AIC↔CCU 同步）：
//   ev[0] = wake（AIC commit → CCU process，循环前唯一一次）
//   ev[t+1] = data 轮 t done（CCU notify → AIC wait，轮 0 含搭载的 scale 整块）

// CCU AllToAll 通信侧 tiling（通信标量散参全部收纳于此；同 shape 下除 params 内
// 四个地址外恒定）
#pragma pack(push, 8)
struct alignas(8) CcuCommTilingData {
    // ---- 形状/轮次（host 填；host/AIC 消费，CCU 走 kernelArg）----
    uint32_t rankId{0};
    uint32_t rankSize{0};
    uint32_t dataCommTurn{0}; // data 轮数（CCU 总轮数 = dataCommTurn，scale 整块随轮 0 搭载）
    uint32_t tileM{0};        // 每 data 轮传输行数
    // ---- 通信参数（host 填；RefreshCcuCommStage 抄入 kernelArg->stage 直达 CCU）----
    CcuCommStageParams params;
    uint64_t workspaceScaleOffset{0}; // workspace 内 recvScale 区偏移（host 侧派生地址用）
    // ---- CCU 资源（host 填；AIC 经 launch 传参消费）----
    CcuMappedAddrs mappedAddrs{}; // CKE 事件槽 MMIO 地址映射（AIC 清扫/commit/轮询用）
    // 轮参数闭式派生（CCU 侧 LoadRoundArgs）：data 轮 t 的 srcOffset = t*subBytes、
    // dstOffset = rankId*blockSize + t*subBytes、sliceSize = subBytes；scale 整块仅随轮 0
    // 搭载：srcOffset = 0、dstOffset = scaleDstOffset（host 烘焙）、sliceSize = scaleSliceSize。
    // 契约强制均分轮次（Validate 整除校验）；若未来需非均匀轮次，须恢复 per-round 表
};
#pragma pack(pop)

// ══════════ §3 host 侧资源装配 ══════════

// CKE 事件槽位预约 + kernelArg 构造（host）。预约的是 CCU 片上硬件寄存器槽位（申请期
// 完成 MMIO 地址映射并烧入 comm.mappedAddrs），非 GM 内存；随通信域实例生命周期回收
inline HcclResult AllocAllToAllRegion(void* insHandle, uint32_t dieId, CcuCommTilingData& comm,
                                      const std::vector<ChannelHandle>& kernelChannels,
                                      std::shared_ptr<CcuKernelArgAllToAllMesh1D>& kernelArg)
{
    const uint8_t ccuDieId = static_cast<uint8_t>(dieId);

    // events: [0]=wake，[t+1]=data 轮 t done（轮 0 含搭载的 scale 整块）
    const uint32_t totalEventNum = comm.dataCommTurn + 1;
    ccu_event_handle eventHandle{0};
    HCCLCHECK(ConvertCcuToHccl(asccomm_ccu_event_alloc(insHandle, ccuDieId, totalEventNum, &eventHandle)));
    for (uint32_t i = 0; i < totalEventNum; i++) {
        HCCLCHECK(ConvertCcuToHccl(asccomm_ccu_event_get_addr(eventHandle, i, &comm.mappedAddrs.eventVa[i])));
    }

    kernelArg = std::make_shared<CcuKernelArgAllToAllMesh1D>();
    kernelArg->rankSize = comm.rankSize;
    kernelArg->rankId = comm.rankId;
    kernelArg->channelCount = static_cast<uint32_t>(kernelChannels.size());
    kernelArg->eventHandle = eventHandle;
    kernelArg->eventNum = totalEventNum;
    // CCU kernel 循环次数 = dataCommTurn（轮 0 = data 块 0 + scale 整块搭载）
    kernelArg->commTurn = comm.dataCommTurn;
    // kernelArg->stage 由消费方 host 每次调用经 RefreshCcuCommStage 刷新
    for (uint32_t i = 0; i < kernelChannels.size(); ++i) {
        kernelArg->channels[i] = kernelChannels[i];
    }
    return HCCL_SUCCESS;
}

// 释放 CCU 资源，与 AllocAllToAllRegion 配对。
// 实例归通信域持有，随 comm 销毁回收，此处仅复位本地句柄；调用时机仍为
// 迭代循环外双流 sync 之后
inline HcclResult ReleaseCcuContext(CcuCommTilingData& comm, void*& insHandle)
{
    (void)comm;
    insHandle = nullptr;
    return HCCL_SUCCESS;
}

// ══════════ §4 __ccu_host__ 通信 kernel ══════════

// CcuAllToAllMesh1DKernel——CCU AllToAll 通信 kernel（运行在 streamCcu 上）。
// ⚠️ kernel 名冻结："CcuAllToAllMesh1DKernel" 参与 binaryCacheTag 哈希（tag = hash +
//    rankId），永不改名；本文件每二进制只能 include 一次（锚点唯一引入）。
// 轮循环（每轮三步）：LoadArgs（从 stage 闭式派生；t==0 另派生 scale 整块参数）→
//   ExecuteAllToAllTransfer（远端 Write 逐 rank 递推 + 本地块 GroupCopy；t==0 附带
//   scale 整块换块）→ PostSync（逐通道确认落地）→ notify（EventRecord events[t+1]）。
// PreSync 全帧仅一次（wake 后）：单类发布 (recvBuf, token)——scale 目的地址由对端从
//   发布值 + scaleDstOffset 闭式派生；帧间发布值恒定（workspace 跨帧复用）→ 同值覆写
//   幂等，无槽位竞态；workspace 换址须重建实例（Release → Prepare）

// 对端通道槽位编号（PublishOutputAndToken 发布 / ExecuteAllToAllTransfer 取用）
constexpr int OUTPUT_XN_ID = 1;
constexpr int TOKEN_XN_ID = 2;
constexpr int POST_SYNC_ID = 3;
constexpr int CKE_IDX_0 = 0;

// 等 AIC commit 后启动通信（唯一一次，轮循环前）
static inline void ProcessCcuCommStart(ccu::array<ccu::event>& events)
{
    ccu::event_wait(events[0]);
}

// 本轮通信完成，告知 AIC（轮 t → events[t+1]，轮 0 含其搭载的 scale 整块）
static inline void NotifyAicoreCommDone(ccu::array<ccu::event>& events, uint32_t round)
{
    ccu::event_record(events[round + 1]);
}

// 向所有对端发布本 rank 的接收地址(output)与访问令牌(token)并等待全组到达。
// 全帧仅此一次，值为 data 类 (recvBuf, token)；scale 目的地址由对端以发布值 +
// scaleDstOffset 闭式派生
static inline void PublishOutputAndToken(AllToAllMesh1DContext& ctx)
{
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::write_variable_with_notify(ctx.arg->channels[i], ctx.selfOutput, OUTPUT_XN_ID, CKE_IDX_0,
                                                         1 << OUTPUT_XN_ID));
        CCU_CHK_VOID_RET(ccu::write_variable_with_notify(ctx.arg->channels[i], ctx.selfToken, TOKEN_XN_ID, CKE_IDX_0,
                                                         1 << TOKEN_XN_ID));
    }

    uint32_t allBit = (1 << OUTPUT_XN_ID) | (1 << TOKEN_XN_ID);
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::notify_wait(ctx.arg->channels[i], CKE_IDX_0, allBit));
    }
}

// 从 stage 参数块闭式派生本轮参数并 imm 赋值进寄存器——data 轮 t：src=t*subBytes、
// dst=rankId*blockSize+t*subBytes、slice=subBytes（契约强制均分轮次）；t==0 时另装载
// scale 整块参数（src=0、dst=scaleDstOffset[host 烘焙]、slice=scaleSliceSize）
static inline void LoadRoundArgs(AllToAllMesh1DContext& ctx, const CcuCommStageParams& stage, uint32_t t)
{
    ctx.data.input = stage.x1Addr;
    ctx.data.srcOffset = t * stage.subBytes;
    ctx.data.srcToken = stage.token;
    ctx.data.dstOffset = static_cast<uint64_t>(ctx.arg->rankId) * stage.blockSize + t * stage.subBytes;
    ctx.data.sliceSize = stage.subBytes;
    ctx.data.srcStride = stage.srcStride;
    ctx.data.goSize.addrOffset = stage.goSize.addrOffset;
    ctx.data.goSize.loopIterNum = stage.goSize.loopIterNum;
    ctx.data.goSize.loopExtendNum = stage.goSize.loopExtendNum;
    ctx.data.goSize.tailSize = stage.goSize.tailSize;

    if (t == 0) {
        ctx.scale.input = stage.x1ScaleAddr;
        ctx.scale.srcOffset = 0;
        ctx.scale.srcToken = stage.scaleToken;
        ctx.scale.dstOffset = stage.scaleDstOffset;
        ctx.scale.sliceSize = stage.scaleSliceSize;
        ctx.scale.srcStride = stage.scaleSrcStride;
        ctx.scale.goSize.addrOffset = stage.scaleGoSize.addrOffset;
        ctx.scale.goSize.loopIterNum = stage.scaleGoSize.loopIterNum;
        ctx.scale.goSize.loopExtendNum = stage.scaleGoSize.loopExtendNum;
        ctx.scale.goSize.tailSize = stage.scaleGoSize.tailSize;
    }
}

// 单货类换块传输（CCU 核内）：远端逐 rank ccu::write（src 逐 rank 递推 srcStride）+
// 本地块 GroupCopy。无轮内屏障——落地确认由主循环 PostSync 统一承担
static CcuResult ExecuteBlockTransfer(AllToAllMesh1DContext& ctx, AllToAllBlockParams& p)
{
    ccu::local_addr src;
    ccu::local_addr localSrc;
    ccu::local_addr localDst;
    std::vector<ccu::remote_addr> dst;

    dst.resize(ctx.arg->rankSize);

    // src 起点：本 rank sendBuf 第 0 块 + 轮级偏移
    src.addr_ = p.input;
    src.addr_ += p.srcOffset;
    src.token = p.srcToken;

    // localSrc：本 rank sendBuf 的第 myRank 块（累加递推，规避标量×Variable 运算）
    localSrc.addr_ = p.input;
    localSrc.addr_ += p.srcOffset;
    localSrc.token = p.srcToken;
    for (uint64_t k = 0; k < ctx.arg->rankId; k++) {
        localSrc.addr_ += p.srcStride;
    }

    // 每个 rank 的目标地址：本 rank → localDst，其他 rank → dst[j]（dstOffset 相对对端
    // 发布的 recvBuf 地址，data/scale 的偏移均 host 预乘/烘焙）
    for (uint64_t j = 0; j < ctx.arg->rankSize; j++) {
        if (j == ctx.arg->rankId) {
            localDst.addr_ = ctx.selfOutput;
            localDst.addr_ += p.dstOffset;
            localDst.token = ctx.selfToken;
        } else {
            dst[j].addr_ = ctx.routing[j].output;
            dst[j].addr_ += p.dstOffset;
            dst[j].token = ctx.routing[j].token;
        }
    }

    // 远端换块：sendBuf 第 j 块 → 远端 rank j 的接收区（data：recvBuf 第 myRank 块内；
    // scale：recvScale 第 myRank 块内，经 dstOffset 派生）
    CCU_IF(p.sliceSize != 0)
    {
        uint32_t channelIdx = 0;
        for (uint64_t j = 0; j < ctx.arg->rankSize; j++) {
            if (j != ctx.arg->rankId) {
                const uint16_t mask = static_cast<uint16_t>(1u << j);
                CCU_CHK_RET(ccu::write(ctx.arg->channels[channelIdx], dst[j], src, p.sliceSize, ctx.event, mask));
                channelIdx++;
            }
            src.addr_ += p.srcStride;
        }
    }

    // 本地拷贝：本 rank 留给自己的块（sliceSize==0 时 goSize 全零 → 空操作，安全）
    CCU_CHK_RET(GroupCopy(ctx, localDst, localSrc, p.goSize));

    return CcuResult::CCU_SUCCESS;
}

// 执行单轮 AllToAll 传输：data 轮 t；t==0 时附带 scale 整块（一次 Write/对端，不拆分）
static CcuResult ExecuteAllToAllTransfer(AllToAllMesh1DContext& ctx, uint32_t t)
{
    CCU_CHK_RET(ExecuteBlockTransfer(ctx, ctx.data));
    if (t == 0) {
        CCU_CHK_RET(ExecuteBlockTransfer(ctx, ctx.scale));
    }
    return CcuResult::CCU_SUCCESS;
}

// CCU 通信 kernel 主入口（__ccu_host__，运行在 streamCcu 上）：
// InitResource（单类路由）→ process（等 wake）→ PreSync（唯一一次，data 类）→
// 循环 commTurn 次（LoadArgs → DoAlltoAll → PostSync → notify）
__ccu_host__ void CcuAllToAllMesh1DKernel(CcuKernelArg arg)
{
    auto* kernelArg = static_cast<CcuKernelArgAllToAllMesh1D*>(arg);

    AllToAllMesh1DContext ctx;
    ctx.arg = kernelArg;

    if (ctx.arg->channelCount == 0) {
        return;
    }
    if (ctx.arg->commTurn == 0) {
        return;
    }

    // ---- InitResource：对端路由 + 事件绑定（参数随 kernelArg->stage 按值到达）----
    const CcuCommStageParams& stage = kernelArg->stage;
    ctx.routing.resize(ctx.arg->rankSize);
    uint32_t channelIdx = 0;
    for (uint64_t peerId = 0; peerId < ctx.arg->rankSize; peerId++) {
        if (peerId != ctx.arg->rankId) {
            ctx.routing[peerId].output =
                ccu::get_res_by_channel<ccu::variable>(ctx.arg->channels[channelIdx], OUTPUT_XN_ID);
            ctx.routing[peerId].token =
                ccu::get_res_by_channel<ccu::variable>(ctx.arg->channels[channelIdx], TOKEN_XN_ID);
            channelIdx++;
        }
    }

    // events: [0]=wake, [t+1]=data 轮 t done（轮 0 含其搭载的 scale 整块）
    ccu::array<ccu::event> events(ctx.arg->eventHandle, ctx.arg->eventNum);

    ProcessCcuCommStart(events);

    // PreSync（全帧唯一一次，data 类）：scale 目的地址由对端从发布值闭式派生
    ctx.selfOutput = stage.recvBufAddr;
    ctx.selfToken = stage.token;
    PublishOutputAndToken(ctx);

    for (uint32_t t = 0; t < ctx.arg->commTurn; t++) {
        LoadRoundArgs(ctx, stage, t);
        CCU_CHK_VOID_RET(ExecuteAllToAllTransfer(ctx, t));

        // PostSync：逐通道确认本轮全部传输（含轮 0 搭载的 scale）在对端落地后，才放行 AIC
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::notify_record(ctx.arg->channels[i], CKE_IDX_0, 1 << POST_SYNC_ID));
        }
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::notify_wait(ctx.arg->channels[i], CKE_IDX_0, 1 << POST_SYNC_ID));
        }

        NotifyAicoreCommDone(events, t);
    }
}
